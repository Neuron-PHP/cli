#!/usr/bin/env php
<?php

/**
 * Neuron CLI - Command-line interface for the Neuron PHP framework
 *
 * This script serves as the entry point for the Neuron CLI tool.
 * It can be installed globally via Composer or run locally.
 */

// Find and load the autoloader
$autoloaderPaths = [
	// When installed globally via Composer
	__DIR__ . '/../../../autoload.php',
	// When in development or installed as a dependency
	__DIR__ . '/../vendor/autoload.php',
	// When installed in a project
	__DIR__ . '/../../../../vendor/autoload.php',
	// Alternative paths
	dirname( __DIR__, 3 ) . '/vendor/autoload.php',
	dirname( __DIR__, 4 ) . '/vendor/autoload.php',
];

// Prefer the autoloader provided by Composer's bin proxy. When this binary is
// symlinked (Composer path repositories / monorepo development), __DIR__ points
// at the CLI component's own source tree, so the relative heuristics below would
// load the wrong vendor/. The proxy exposes the consuming project's autoloader
// via this global, which is authoritative.
$autoloaderFound = false;

if( isset( $GLOBALS['_composer_autoload_path'] ) && file_exists( $GLOBALS['_composer_autoload_path'] ) )
{
	require_once $GLOBALS['_composer_autoload_path'];
	$autoloaderFound = true;
}

if( !$autoloaderFound )
{
	foreach( $autoloaderPaths as $path )
	{
		if( file_exists( $path ) )
		{
			require_once $path;
			$autoloaderFound = true;
			break;
		}
	}
}

if( !$autoloaderFound )
{
	fwrite( STDERR, "Error: Unable to find Composer autoloader.\n" );
	fwrite( STDERR, "Please run 'composer install' to install dependencies.\n" );
	exit( 1 );
}

// Check PHP version
if( version_compare( PHP_VERSION, '8.4.0', '<' ) )
{
	fwrite( STDERR, "Error: Neuron CLI requires PHP 8.4 or higher.\n" );
	fwrite( STDERR, "Current PHP version: " . PHP_VERSION . "\n" );
	exit( 1 );
}

// Load configuration.
// SettingManagerFactory loads every layer that exists and falls back to the
// environment for the rest:
// - Base config (neuron.yaml)
// - Environment-specific config (environments/{env}.yaml)
// - Base secrets (secrets.yml.enc)
// - Environment-specific secrets (environments/{env}.secrets.yml.enc)
// - Environment variables (fallback)
// Every file is optional: a container configured purely through environment
// variables has a config/ directory with no neuron.yaml, and its settings
// must still reach the Registry. A directory holding neuron.yaml is
// preferred when more than one candidate exists.
$settings = null;
$configPaths = array_filter( [ getcwd() . '/config', getcwd() ], 'is_dir' );

usort( $configPaths, fn( $a, $b ) => file_exists( "$b/neuron.yaml" ) <=> file_exists( "$a/neuron.yaml" ) );

foreach( $configPaths as $configPath )
{
	try
	{
		$settings = \Neuron\Data\Settings\SettingManagerFactory::create( null, $configPath );
		break;
	}
	catch( \Exception $e )
	{
		// Silently ignore config loading errors
	}
}

// Create and run the application
try
{
	$app = new \Neuron\Cli\Application( '0.1.0', $settings );

	// Pass command-line arguments to the application
	$app->run( $argv );
	
	// Get the exit code from command execution
	$exitCode = $app->getExitCode();

	exit( $exitCode );
}
catch( \Exception $e )
{
	fwrite( STDERR, "Fatal error: " . $e->getMessage() . "\n" );

	// If verbose mode is enabled, show the stack trace
	if( in_array( '--verbose', $argv ) || in_array( '-v', $argv ) )
	{
		fwrite( STDERR, "\nStack trace:\n" );
		fwrite( STDERR, $e->getTraceAsString() . "\n" );
	}

	exit( 1 );
}
